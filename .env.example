# ─────────────────────────────────────────────────────────────
#  MOLARA · Variables de entorno  (copia este archivo a .env.local)
# ─────────────────────────────────────────────────────────────

# URL pública de la app (en Vercel: https://tu-proyecto.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
# Clave SECRETA (Supabase → Project Settings → API Keys → Secret keys).
# Solo se usa en el servidor: webhook de WhatsApp, alta de usuarios, reservas web.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx

# ── Meta · WhatsApp Cloud API (app de la plataforma) ─────────
META_APP_ID=                 # App del número de ejemplo (el formulario de cada consultorio pide su propio App ID/Secret)
META_APP_SECRET=            # valida la firma X-Hub-Signature-256 del webhook
API_VERSION=v22.0
WEBHOOK_VERIFY_TOKEN=       # el mismo que pegas en Meta → WhatsApp → Configuración → Webhook
# Número de DEMOSTRACIÓN (se ofrece como ejemplo en el formulario de conexión)
BUSINESS_PHONE=             # Phone Number ID
WABA_ID=                    # WhatsApp Business Account ID
WHATSAPP_ACCESS_TOKEN=

# ── Vercel AI Gateway ────────────────────────────────────────
# En Vercel se autentica solo con OIDC; en local crea una API key en
# Vercel → AI Gateway → API Keys. Sin clave, el bot funciona 100% con botones.
AI_GATEWAY_API_KEY=
AI_MODEL=openai/gpt-4.1-mini

# ── Cron de recordatorios (Vercel lo envía como Bearer) ──────
CRON_SECRET=cambia-esto-por-un-texto-largo
